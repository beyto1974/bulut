# production | testing | development. Anything but production is shown in the UI header and title.
APP_ENV=development
# error | warn | info | debug | trace. Logs are JSON lines on stdout.
LOG_LEVEL=info
PORT=8080
# Host port of the container. Never hardcode one on the shared dev box: run `freeport` and put it here.
HOST_PORT=
# Public base URL, used for short links and the QR code.
BASE_URL=http://localhost:8080
# Length of the short session code (look-alike characters are never used).
CODE_LENGTH=5
# Upload part size in bytes, at least 5 MiB (S3 multipart minimum).
CHUNK_SIZE=8388608
# Folders are built but switched off for now. Keep false until the UI supports them.
FOLDERS_ENABLED=false
# Largest accepted file in bytes (default 1 GiB).
MAX_FILE_BYTES=1073741824
# Sessions with no activity (views, downloads, uploads, API reads) for this many days are deleted.
SESSION_IDLE_TTL_DAYS=7
SWEEP_INTERVAL_SECS=3600

# Filled by `devdb create --project bulut` and `devgarage create --project bulut`.
DATABASE_URL=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=garage
