# production | testing | development. Anything but production is shown in the UI header and title.
APP_ENV=development
# error | warn | info | debug | trace. Logs are JSON lines on stdout.
LOG_LEVEL=info
PORT=8080
# Address to listen on. 0.0.0.0 suits a container, use 127.0.0.1 for a bare install behind a local proxy.
BIND_ADDR=0.0.0.0
# Host port for the development compose file (docker-compose.yml). Pick a free one.
HOST_PORT=
# Public base URL, used for short links and the QR code.
BASE_URL=http://localhost:8080
# Length of the short session code (look-alike characters are never used).
CODE_LENGTH=5
# Upload part size in bytes, at least 5 MiB (S3 multipart minimum).
CHUNK_SIZE=8388608
# Folders are built but switched off for now. Keep false until the UI supports them.
FOLDERS_ENABLED=false
# Largest accepted file in bytes (default 1 GiB).
MAX_FILE_BYTES=1073741824
# Most files one session can hold. A new version of an existing file does not count.
MAX_FILES_PER_SESSION=100
# Other limits that keep one session from filling the storage.
MAX_VERSIONS_PER_FILE=50
MAX_SESSION_BYTES=10737418240
MAX_PENDING_UPLOADS=10
MAX_TAGS_PER_VERSION=20
# Sessions with no activity (views, downloads, uploads, API reads) for this many days are deleted.
SESSION_IDLE_TTL_DAYS=7
SWEEP_INTERVAL_SECS=3600
# Objects in the bucket that no file refers to (left by a crash or a purge that raced an upload)
# are deleted once they are this many hours old. 0 switches the clean-up off.
ORPHAN_GRACE_HOURS=24

# Postgres and an S3-compatible bucket. The bucket is created at startup if it does not exist.
DATABASE_URL=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=garage
